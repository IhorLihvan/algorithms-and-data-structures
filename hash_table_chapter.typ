#import "common.typ": *

// Текстова колонка вузька, тож код трохи дрібніший
#show raw.where(block: true): set text(size: 8pt)

// Схеми в розділі містять `код`, тож Typst підписав би їх «Лістинг».
// Нумеруємо їх як рисунки; таблиці позначаємо явно: kind: table.
#set figure(kind: image)

// Комірка схеми пам'яті
#let cell(body, fill: none) = rect(inset: 5pt, fill: fill, text(size: 8pt, body))

// Блок псевдокоду (як у розділі «Таблиця»)
#let pseudo(body) = block(
  fill: rgb("#fcfaf2"),
  stroke: 0.5pt + luma(200),
  inset: 1em,
  radius: 4pt,
  width: 100%,
  body,
)

// Рядок схеми ланцюжків: номер комірки, далі вузли списку
#let chain-row(i, keys, width: 9) = {
  let row = (cell(fill: luma(230))[#i],)
  if keys.len() == 0 {
    row.push([`NIL`])
  } else {
    for k in keys {
      row += ([$arrow.r$], cell[#k])
    }
    row += ([$arrow.r$], [$emptyset$])
  }
  while row.len() < width {
    row.push([])
  }
  row
}

// Рядок схеми відкритої адресації: підпис і m комірок;
// hl --- номери комірок, куди ключ потрапив після колізії
#let slot-row(label, keys, hl: ()) = (
  text(size: 8pt, label),
  ..keys.enumerate().map(((q, k)) => {
    let body = if k == none [] else [#text(size: 8pt)[#k]]
    if q in hl {
      table.cell(fill: rgb("#fde7c8"), body)
    } else {
      body
    }
  }),
)

