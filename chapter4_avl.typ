Зверніть увагу на кілька деталей:

- у `rebalance` умова `bf < -1` рівносильна $op("bf")(x) = -2$, бо за передумовою різниця висот не перевищує 2; перевірка `balanceFactor(n->left) > 0` відрізняє випадок LR від LL (у випадку $op("bf")(y) = 0$, можливому лише при вилученні, виконується однократне обертання, див. @tbl-avl-cases);
- рядок `n->left = rotateLeft(std::move(n->left))` є першим кроком двократного обертання: вузол $y$ підміняється на $x$;
- на зворотному шляху `rebalance` викликається для кожного вузла, тому висоти всіх предків оновлюються; обертання виконуються лише там, де порушено умову;
- якщо ключ уже є в дереві, `insert` повертає вузол без змін і не викликає `rebalance`, а `erase` для відсутнього ключа доходить до порожнього піддерева і так само нічого не змінює.



// ============================================================================
// ЧАСТИНА C: «Аналіз складності» та «Приклад виконання та покрокове трасування».
// Дописати в кінець chapter4_avl.typ (після частин A і B).
// Висота скрізь за CLRS: лист --- 0, порожнє піддерево --- -1.
// ============================================================================

// ---------- Допоміжні засоби частини C ----------

// Макет дерева за специфікацією (ключ, ліве, праве[, (bf: .., hot: ..)]); none --- порожнє піддерево.
// x-координата вузла --- його номер у симетричному обході, y = -глибина.
#let tree-layout(t, depth, cx) = {
  if t == none { return (nodes: (), edges: (), next: cx, root: none) }
  let L = tree-layout(t.at(1), depth + 1, cx)
  let x = L.next
  let R = tree-layout(t.at(2), depth + 1, x + 1)
  let pos = (x, -depth)
  let edges = L.edges + R.edges
  if L.root != none { edges.push((pos, L.root)) }
  if R.root != none { edges.push((pos, R.root)) }
  (nodes: L.nodes + R.nodes + ((pos, t),), edges: edges, next: R.next, root: pos)
}

// Малювання дерева у CeTZ: червоне число --- bf, червоний вузол --- порушення умови AVL
#let tree-draw(t, dx: 1.0, dy: 1.25) = {
  let lay = tree-layout(t, 0, 0)
  for (a, b) in lay.edges {
    tedge((a.at(0) * dx, a.at(1) * dy), (b.at(0) * dx, b.at(1) * dy))
  }
  for (pos, node) in lay.nodes {
    let p = (pos.at(0) * dx, pos.at(1) * dy)
    let o = node.at(3, default: (:))
    let hot = o.at("hot", default: false)
    draw.circle(p, radius: 0.42, fill: if hot { rgb("#f8d7d7") } else { white }, stroke: 0.8pt)
    draw.content(p, text(size: 8.5pt)[#node.at(0)])
    if "bf" in o {
      tbf(p, if o.bf > 0 { [$+#o.bf$] } else { [$#o.bf$] })
    }
  }
}

// Кілька дерев поруч, кожне з підписом
#let tree-panels(items, cols: auto, len: 0.55cm) = {
  let n = if cols == auto { items.len() } else { cols }
  grid(
    columns: (1fr,) * n, column-gutter: 0.8em, row-gutter: 1.2em,
    align: center + top,
    ..items.map(it => [
      #canvas(length: len, { tree-draw(it.at(0)) })
      #v(0.2em)
      #text(size: 9pt)[#it.at(1)]
    ]),
  )
}

// Дерево Фібоначчі T_h (за CLRS: висота листка 0, T_(-1) порожнє) з ключами k, k+1, ...;
// повертає (дерево, наступний вільний ключ)
#let fib-tree(h, k) = {
  if h < 0 { return (none, k) }
  if h == 0 { return ((k, none, none), k + 1) }
  let (l, k1) = fib-tree(h - 1, k)
  let (r, k2) = fib-tree(h - 2, k1 + 1)
  ((k1, l, r), k2)
}

