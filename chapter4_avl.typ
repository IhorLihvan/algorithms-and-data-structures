Останній стовпець пояснює різницю між вставленням і вилученням. Після вставлення обертання повертає піддереву його попередню висоту, тому далі вгору порушень уже немає, і потрібне щонайбільше одне (однократне або двократне) обертання.#src-k("108") Після вилучення висота піддерева може зменшитися, тоді порушення може з'явитися в кожному предку, і обертання потрібні на кожному рівні шляху.#src-k("108")

== Реалізація на C++

=== Псевдокод

Нижче наведено псевдокод у стилі CLRS. Він адаптований до нашої рекурсивної реалізації без вказівників на батька: обертання повертає новий корінь піддерева, а `BALANCE` відповідає однойменній процедурі із задачі 13-3.#src-c("357–358") Усюди $h("NIL") = -1$, $op("bf")(x) = h(x."right") - h(x."left")$.

#figure(
  align(left)[
    #block(fill: rgb("#fcfaf2"), stroke: 0.5pt + luma(200), inset: 1em, radius: 4pt)[
      *`RIGHT-ROTATE`*$(z)$ \
      1. `y = z.left` \
      2. `z.left = y.right` \
      3. `y.right = z` \
      4. `UPDATE-HEIGHT`$(z)$; `UPDATE-HEIGHT`$(y)$ \
      5. *return* `y` \
      \
      *`BALANCE`*$(x)$ \
      1. `UPDATE-HEIGHT`$(x)$ \
      2. *if* $op("bf")(x) == -2$ #h(1em) // ліве піддерево вище \
      3. $quad$ *if* $op("bf")$`(x.left)` $> 0$ #h(1em) // випадок LR \
      4. $quad quad$ `x.left = LEFT-ROTATE(x.left)` \
      5. $quad$ *return* `RIGHT-ROTATE(x)` \
      6. *if* $op("bf")(x) == +2$ \
      7. $quad$ *if* $op("bf")$`(x.right)` $< 0$ #h(1em) // випадок RL \
      8. $quad quad$ `x.right = RIGHT-ROTATE(x.right)` \
      9. $quad$ *return* `LEFT-ROTATE(x)` \
      10. *return* `x` \
      \
      *`AVL-INSERT`*$(x, k)$ \
      1. *if* `x == NIL` *return* новий вузол з ключем $k$ і `height = 0` \
      2. *if* $k <$ `x.key`: `x.left = AVL-INSERT(x.left, k)` \
      3. *elseif* $k >$ `x.key`: `x.right = AVL-INSERT(x.right, k)` \
      4. *else return* `x` #h(1em) // ключ уже є \
      5. *return* `BALANCE(x)` \
      \
      *`AVL-DELETE`*$(x, k)$ \
      1. *if* `x == NIL` *return* `NIL` \
      2. *if* $k <$ `x.key`: `x.left = AVL-DELETE(x.left, k)` \
      3. *elseif* $k >$ `x.key`: `x.right = AVL-DELETE(x.right, k)` \
      4. *else if* `x.left == NIL` *return* `x.right` \
      5. $quad$ *elseif* `x.right == NIL` *return* `x.left` \
      6. $quad$ *else* `y = TREE-MINIMUM(x.right)` #h(1em) // наступник вузла `x` \
      7. $quad quad$ `x.key = y.key` \
      8. $quad quad$ `x.right = AVL-DELETE(x.right, y.key)` \
      9. *return* `BALANCE(x)`
    ]
  ],
  caption: [Псевдокод основних процедур AVL-дерева (`LEFT-ROTATE` --- симетрична до `RIGHT-ROTATE`)]
) <avl-pseudocode>

Дерево змінюється викликами `root = AVL-INSERT(root, k)` та `root = AVL-DELETE(root, k)`. У `AVL-DELETE` для вузла з двома нащадками береться наступник --- мінімальний вузол правого піддерева, як у `TREE-DELETE` з CLRS.#src-c("322–325") Костів замінює такий вузол найправішим вузлом лівого піддерева;#src-k("108") обидва способи коректні. Щоб не перевстановлювати вказівники, ми копіюємо ключ наступника у вузол, що вилучається (якщо у вузлі є супутні дані, їх теж треба скопіювати), а потім вилучаємо наступника з правого піддерева.

=== Програмний код

Клас `AVLTree` написано мовою C++17 як шаблон за типом ключа; від ключа потрібен лише оператор `<`. Вузли належать дереву через `std::unique_ptr`, тому ручного `delete` немає.

```cpp
#include <algorithm>
#include <cstddef>
#include <cstdlib>
#include <iostream>
#include <memory>
#include <vector>

// AVL-дерево. Висота: лист має висоту 0, порожнє піддерево -- висоту -1 (як у CLRS).
template <typename Key>
class AVLTree {
    struct Node {
        Key key;
        int height = 0;                    // висота вузла (лист -> 0)
        std::unique_ptr<Node> left, right;
        explicit Node(const Key& k) : key(k) {}
    };
    using NodePtr = std::unique_ptr<Node>;

    NodePtr root_;
    std::size_t size_ = 0;

    // ---------- допоміжні функції ----------
    static int height(const NodePtr& n) { return n ? n->height : -1; }

    static void updateHeight(Node& n) {
        n.height = 1 + std::max(height(n.left), height(n.right));
    }

    // bf(x) = h(right) - h(left)
    static int balanceFactor(const NodePtr& n) {
        return n ? height(n->right) - height(n->left) : 0;
    }

    // ---------- обертання (повертають новий корінь піддерева) ----------
    // Праве обертання навколо z: ліве піддерево y піднімається, z стає правим нащадком y,
    // а колишнє праве піддерево y (B) переходить до z як ліве. Порядок ключів зберігається.
    static NodePtr rotateRight(NodePtr z) {
        NodePtr y = std::move(z->left);
        z->left = std::move(y->right);   // B стає лівим нащадком z
        updateHeight(*z);                // спочатку нижній вузол
        y->right = std::move(z);
        updateHeight(*y);
        return y;
    }

    static NodePtr rotateLeft(NodePtr z) {
        NodePtr y = std::move(z->right);
        z->right = std::move(y->left);
        updateHeight(*z);
        y->left = std::move(z);
        updateHeight(*y);
        return y;
    }

    // Передумова: піддерева n збалансовані, а їхні висоти відрізняються не більше ніж на 2.
    static NodePtr rebalance(NodePtr n) {
        updateHeight(*n);
        const int bf = balanceFactor(n);
        if (bf < -1) {                                   // ліве піддерево вище
            if (balanceFactor(n->left) > 0)              // випадок LR
                n->left = rotateLeft(std::move(n->left));
            return rotateRight(std::move(n));            // LL (або друга половина LR)
        }
        if (bf > 1) {                                    // праве піддерево вище
            if (balanceFactor(n->right) < 0)             // випадок RL
                n->right = rotateRight(std::move(n->right));
            return rotateLeft(std::move(n));             // RR (або друга половина RL)
        }
        return n;
    }

    // ---------- вставлення ----------
    static NodePtr insert(NodePtr n, const Key& key, bool& inserted) {
        if (!n) {
            inserted = true;
            return std::make_unique<Node>(key);
        }
        if (key < n->key)
            n->left = insert(std::move(n->left), key, inserted);
        else if (n->key < key)
            n->right = insert(std::move(n->right), key, inserted);
        else
            return n;                                    // ключ уже є
        return rebalance(std::move(n));
    }

    // ---------- вилучення ----------
    static const Node* minNode(const Node* n) {
        while (n->left) n = n->left.get();
        return n;
    }

    static NodePtr erase(NodePtr n, const Key& key, bool& erased) {
        if (!n) return n;                                // ключа немає
        if (key < n->key) {
            n->left = erase(std::move(n->left), key, erased);
        } else if (n->key < key) {
            n->right = erase(std::move(n->right), key, erased);
        } else {
            erased = true;
            if (!n->left)  return std::move(n->right);   // 0 або 1 нащадок
            if (!n->right) return std::move(n->left);
            // два нащадки: замінюємо ключ наступником (мінімум правого піддерева)
            n->key = minNode(n->right.get())->key;
            bool dummy = false;
            n->right = erase(std::move(n->right), n->key, dummy);
        }
        return rebalance(std::move(n));
    }

    // ---------- допоміжні обходи ----------
    static void inorder(const Node* n, std::vector<Key>& out) {
        if (!n) return;
        inorder(n->left.get(), out);
        out.push_back(n->key);
        inorder(n->right.get(), out);
    }

    // Перевірка: порядок ключів, збережені висоти та умова |bf| <= 1.
    static bool check(const Node* n, const Key* lo, const Key* hi, int& h) {
        if (!n) { h = -1; return true; }
        if ((lo && !(*lo < n->key)) || (hi && !(n->key < *hi))) return false;
        int hl = 0, hr = 0;
        if (!check(n->left.get(), lo, &n->key, hl)) return false;
        if (!check(n->right.get(), &n->key, hi, hr)) return false;
        h = 1 + std::max(hl, hr);
        return h == n->height && std::abs(hr - hl) <= 1;
    }

public:
    bool insert(const Key& key) {
        bool inserted = false;
        root_ = insert(std::move(root_), key, inserted);
        if (inserted) ++size_;
        return inserted;
    }

    bool erase(const Key& key) {
        bool erased = false;
        root_ = erase(std::move(root_), key, erased);
        if (erased) --size_;
        return erased;
    }

    bool contains(const Key& key) const {                // ITERATIVE-TREE-SEARCH
        const Node* x = root_.get();
        while (x) {
            if (key < x->key)      x = x->left.get();
            else if (x->key < key) x = x->right.get();
            else                   return true;
        }
        return false;
    }

    int height() const { return height(root_); }         // порожнє дерево -> -1
    std::size_t size() const { return size_; }
    bool empty() const { return size_ == 0; }

    std::vector<Key> inorder() const {
        std::vector<Key> out;
        inorder(root_.get(), out);
        return out;
    }

    bool isValid() const {
        int h = 0;
        return check(root_.get(), nullptr, nullptr, h);
    }
};
```

Приклад використання. Вставимо ключі $1, 2, dots, 7$ у зростаючому порядку --- той самий вхід, що перетворював звичайне BST на ланцюг (@fig-avl-chain-vs-balanced), --- а потім вилучимо ключ 4:

```cpp
int main() {
    AVLTree<int> t;
    for (int k = 1; k <= 7; ++k) t.insert(k);
    std::cout << "Висота: " << t.height() << ", вузлів: " << t.size() << '\n';
    t.erase(4);
    std::cout << "Після видалення 4 висота: " << t.height() << ", коректне: " << std::boolalpha << t.isValid() << '\n';
    for (int k : t.inorder()) std::cout << k << ' ';
    std::cout << '\n';
}
```

Виведення програми:

```text
Висота: 2, вузлів: 7
Після видалення 4 висота: 2, коректне: true
1 2 3 5 6 7
```

Висота дерева дорівнює $2$ --- як у збалансованому дереві на @fig-avl-chain-vs-balanced, б, тоді як звичайне BST мало б висоту $6$.

