У прикладі нижче ми реалізуємо чергу на циклічному масиві з подвоєнням місткості.

== Реалізація на C++

Шаблонний клас `Queue<T>`, а після нього задача планування процесорного часу (round robin), про яку йшлося в мотивації.

```cpp
#include <algorithm>
#include <iostream>
#include <stdexcept>
#include <vector>

// Черга на циклічному масиві; T --- тип елементів
template <typename T>
class Queue {
private:
    T*     data_;      // циклічний буфер
    size_t head_;      // індекс голови (звідси вилучаємо)
    size_t size_;      // кількість елементів
    size_t capacity_;  // розмір буфера

    // Подвоюємо буфер; елементи переписуємо з нульового індексу
    void grow() {
        size_t newCap = capacity_ * 2;
        T* newData = new T[newCap];
        for (size_t i = 0; i < size_; ++i)
            newData[i] = data_[(head_ + i) % capacity_];
        delete[] data_;
        data_ = newData;
        head_ = 0;
        capacity_ = newCap;
    }

public:
    Queue() : data_(new T[4]), head_(0), size_(0), capacity_(4) {}

    Queue(const Queue&) = delete;
    Queue& operator=(const Queue&) = delete;

    ~Queue() { delete[] data_; }

    bool   empty() const { return size_ == 0; }
    size_t size()  const { return size_; }

    // Додати в хвіст: O(1) амортизовано
    void push(const T& x) {
        if (size_ == capacity_) grow();
        data_[(head_ + size_) % capacity_] = x;  // вільна комірка
        ++size_;
    }

    // Вилучити з голови: O(1)
    void pop() {
        if (empty())
            throw std::underflow_error("pop: черга порожня");
        head_ = (head_ + 1) % capacity_;         // голова зсувається
        --size_;
    }

    // Прочитати голову, не видаляючи: O(1)
    T& front() {
        if (empty())
            throw std::underflow_error("front: черга порожня");
        return data_[head_];
    }
};

// Застосування: розподіл часу процесора (round robin).
// burst[i] --- скільки часу потрібно i-й задачі,
// quantum --- довжина кванта часу.
void roundRobin(const std::vector<int>& burst, int quantum) {
    std::vector<int> left = burst;      // скільки лишилось виконати
    Queue<int> q;
    for (size_t i = 0; i < burst.size(); ++i) q.push((int)i);

    int time = 0;
    while (!q.empty()) {
        int i = q.front();              // беремо задачу з голови
        q.pop();
        int run = std::min(quantum, left[i]);
        time += run;
        left[i] -= run;
        std::cout << char('A' + i) << " працює " << run
                  << ", лишилось " << left[i]
                  << ", t=" << time << "\n";
        if (left[i] > 0) q.push(i);     // не встигла: у хвіст
    }
}

int main() {
    roundRobin({3, 5, 2}, 2);
}
```

Ключовий рядок --- `(head_ + size_) % capacity_`: це індекс першої вільної комірки, і завдяки залишку від ділення він «обертається» на початок масиву. Коли масив повний, `grow` переписує елементи в новий масив у правильному порядку, починаючи з нульового індексу.

== Аналіз складності

Нехай $n$ --- кількість елементів у черзі.

